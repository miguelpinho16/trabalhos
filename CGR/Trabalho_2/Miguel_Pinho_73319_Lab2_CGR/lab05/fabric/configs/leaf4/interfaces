auto lo
iface lo inet loopback
    address 10.0.0.14/32

auto swp1
iface swp1
    address 10.1.4.1/31
    # to spine1 swp4

auto swp2
iface swp2
    address 10.2.4.1/31
    # to spine2 swp4

auto swp3
iface swp3
    bridge-access 20

auto swp4
iface swp4
    bridge-access 30

auto BLUE
iface BLUE
    vrf-table auto

auto RED
iface RED
    vrf-table auto

auto vni10020
iface vni10020
    vxlan-id 10020
    vxlan-local-tunnelip 10.0.0.14
    bridge-access 20
    bridge-learning off
    bridge-arp-nd-suppress on
    # L2VNI of VLAN 20 (RED)

auto vni10030
iface vni10030
    vxlan-id 10030
    vxlan-local-tunnelip 10.0.0.14
    bridge-access 30
    bridge-learning off
    bridge-arp-nd-suppress on
    # L2VNI of VLAN 30 (BLUE)

auto vni5002
iface vni5002
    vxlan-id 5002
    vxlan-local-tunnelip 10.0.0.14
    bridge-access 4002
    bridge-learning off
    # L3VNI of tenant BLUE

auto vni5001
iface vni5001
    vxlan-id 5001
    vxlan-local-tunnelip 10.0.0.14
    bridge-access 4001
    bridge-learning off
    # L3VNI of tenant RED

auto bridge
iface bridge
    bridge-vlan-aware yes
    bridge-ports swp3 swp4 vni10020 vni10030 vni5002 vni5001 
    bridge-vids 20 30 4002 4001 
    bridge-stp off

auto vlan20
iface vlan20
    vlan-id 20
    vlan-raw-device bridge
    address 192.168.20.1/24
    hwaddress 00:00:5e:00:01:01
    arp-accept on
    vrf RED

auto vlan30
iface vlan30
    vlan-id 30
    vlan-raw-device bridge
    address 192.168.10.1/24
    hwaddress 00:00:5e:00:01:01
    arp-accept on
    vrf BLUE

auto vlan4002
iface vlan4002
    vlan-id 4002
    vlan-raw-device bridge
    vrf BLUE

auto vlan4001
iface vlan4001
    vlan-id 4001
    vlan-raw-device bridge
    vrf RED

