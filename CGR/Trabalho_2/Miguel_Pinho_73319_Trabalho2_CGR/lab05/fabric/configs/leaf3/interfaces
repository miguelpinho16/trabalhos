auto lo
iface lo inet loopback
    address 10.0.0.13/32

auto swp1
iface swp1
    address 10.1.3.1/31
    # to spine1 swp3

auto swp2
iface swp2
    address 10.2.3.1/31
    # to spine2 swp3

auto swp3
iface swp3
    bridge-access 10

auto RED
iface RED
    vrf-table auto

auto vni10010
iface vni10010
    vxlan-id 10010
    vxlan-local-tunnelip 10.0.0.13
    bridge-access 10
    bridge-learning off
    bridge-arp-nd-suppress on
    # L2VNI of VLAN 10 (RED)

auto vni5001
iface vni5001
    vxlan-id 5001
    vxlan-local-tunnelip 10.0.0.13
    bridge-access 4001
    bridge-learning off
    # L3VNI of tenant RED

auto bridge
iface bridge
    bridge-vlan-aware yes
    bridge-ports swp3 vni10010 vni5001 
    bridge-vids 10 4001 
    bridge-stp off

auto vlan10
iface vlan10
    vlan-id 10
    vlan-raw-device bridge
    address 192.168.10.1/24
    hwaddress 00:00:5e:00:01:01
    arp-accept on
    vrf RED

auto vlan4001
iface vlan4001
    vlan-id 4001
    vlan-raw-device bridge
    vrf RED

